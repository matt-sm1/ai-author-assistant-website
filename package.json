    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-virtual": "^3.14.21",
    "@tinymce/tinymce-react": "^6.3.0",
